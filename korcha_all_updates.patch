+// src/components/MerchantPortal.tsx: Dedicated Portal for Local Merchants to Submit Inventory & Chat with @korcha_support
+import React, { useState, useEffect } from 'react';
+import { 
+  Package, 
+  Send, 
+  Upload, 
+  MessageCircle, 
+  CheckCircle2, 
+  Clock, 
+  AlertCircle, 
+  DollarSign, 
+  ShoppingBag, 
+  Layers, 
+  Info, 
+  ShieldCheck,
+  ChevronRight,
+  RefreshCw,
+  X
+} from 'lucide-react';
+
+interface MerchantPortalProps {
+  onOpenChatWithWorker?: (ticketCode: string) => void;
+  workerUsername?: string;
+}
+
+export const MerchantPortal: React.FC<MerchantPortalProps> = ({
+  onOpenChatWithWorker,
+  workerUsername = 'korcha_support',
+}) => {
+  const [activeSubTab, setActiveSubTab] = useState<'submit' | 'my_products'>('submit');
+
+  // Form fields
+  const [productName, setProductName] = useState('');
+  const [categoryId, setCategoryId] = useState('womens');
+  const [askingPriceEtb, setAskingPriceEtb] = useState('');
+  const [quantityAtHand, setQuantityAtHand] = useState('1');
+  const [sizeColorDetails, setSizeColorDetails] = useState('');
+  const [merchantPhone, setMerchantPhone] = useState(() => {
+    try { return localStorage.getItem('korcha_merchant_phone') || ''; } catch { return ''; }
+  });
+  const [merchantName, setMerchantName] = useState(() => {
+    try { return localStorage.getItem('korcha_merchant_name') || ''; } catch { return ''; }
+  });
+  const [photoFile, setPhotoFile] = useState<File | null>(null);
+  const [photoPreview, setPhotoPreview] = useState<string>('');
+  const [isSubmitting, setIsSubmitting] = useState(false);
+  const [submissionSuccess, setSubmissionSuccess] = useState<any | null>(null);
+
+  // Submissions list
+  const [mySubmissions, setMySubmissions] = useState<any[]>([]);
+  const [isLoadingSubmissions, setIsLoadingSubmissions] = useState(false);
+
+  const tgUser = typeof window !== 'undefined' ? window.Telegram?.WebApp?.initDataUnsafe?.user : null;
+
+  // Pre-fill Telegram username if available
+  const merchantTgUsername = tgUser?.username || '';
+  const merchantTgId = tgUser?.id || null;
+
+  // Handle Photo selection
+  const handlePhotoChange = (e: React.ChangeEvent<HTMLInputElement>) => {
+    if (e.target.files && e.target.files[0]) {
+      const file = e.target.files[0];
+      setPhotoFile(file);
+      setPhotoPreview(URL.createObjectURL(file));
+    }
+  };
+
+  // Submit merchant product
+  const handleSubmitProduct = async (e: React.FormEvent) => {
+    e.preventDefault();
+    if (!productName.trim()) {
+      alert('እባክዎ የእቃውን ስም ያስገቡ (Please enter product name)');
+      return;
+    }
+    if (!askingPriceEtb || isNaN(Number(askingPriceEtb)) || Number(askingPriceEtb) <= 0) {
+      alert('እባክዎ ትክክለኛ የመሸጫ ዋጋ በብር ያስገቡ (Please enter valid price in ETB)');
+      return;
+    }
+    if (!merchantPhone.trim()) {
+      alert('እባክዎ የመገናኛ ስልክ ቁጥርዎን ያስገቡ (Please enter contact phone)');
+      return;
+    }
+
+    setIsSubmitting(true);
+    try {
+      const formData = new FormData();
+      formData.append('productName', productName.trim());
+      formData.append('categoryId', categoryId);
+      formData.append('askingPriceEtb', askingPriceEtb.trim());
+      formData.append('quantityAtHand', quantityAtHand.trim() || '1');
+      formData.append('sizeColorDetails', sizeColorDetails.trim());
+      formData.append('merchantPhone', merchantPhone.trim());
+      formData.append('merchantName', merchantName.trim() || tgUser?.first_name || 'Merchant');
+      if (merchantTgId) formData.append('telegramId', String(merchantTgId));
+      if (merchantTgUsername) formData.append('telegramUsername', merchantTgUsername);
+      if (photoFile) formData.append('photo', photoFile);
+
+      const res = await fetch('/api/merchant/submissions', {
+        method: 'POST',
+        body: formData,
+      });
+
+      const data = await res.json();
+      if (data.success) {
+        if (window.Telegram?.WebApp?.HapticFeedback) {
+          window.Telegram.WebApp.HapticFeedback.notificationOccurred('success');
+        }
+        localStorage.setItem('korcha_merchant_phone', merchantPhone.trim());
+        if (merchantName.trim()) localStorage.setItem('korcha_merchant_name', merchantName.trim());
+        
+        // Save ticket code in local list
+        try {
+          const raw = localStorage.getItem('korcha_ticket_codes');
+          const list = raw ? JSON.parse(raw) : [];
+          if (!list.includes(data.ticketCode)) {
+            list.unshift(data.ticketCode);
+            localStorage.setItem('korcha_ticket_codes', JSON.stringify(list));
+          }
+        } catch (_) {}
+
+        setSubmissionSuccess(data.submission || { ticket_code: data.ticketCode });
+        // Reset form
+        setProductName('');
+        setAskingPriceEtb('');
+        setQuantityAtHand('1');
+        setSizeColorDetails('');
+        setPhotoFile(null);
+        setPhotoPreview('');
+        fetchMySubmissions();
+      } else {
+        alert(data.error || 'ስህተት ተከስቷል');
+      }
+    } catch (err: any) {
+      alert('ስህተት ተከስቷል: ' + err.message);
+    } finally {
+      setIsSubmitting(false);
+    }
+  };
+
+  // Fetch only this merchant's submitted inventory
+  const fetchMySubmissions = async () => {
+    setIsLoadingSubmissions(true);
+    try {
+      const phone = merchantPhone.trim() || localStorage.getItem('korcha_merchant_phone') || '';
+      let codes: string[] = [];
+      try {
+        const raw = localStorage.getItem('korcha_ticket_codes');
+        codes = raw ? JSON.parse(raw) : [];
+      } catch (_) {}
+
+      const params = new URLSearchParams();
+      if (phone) params.set('phone', phone);
+      if (merchantTgId) params.set('telegramId', String(merchantTgId));
+      if (codes.length > 0) params.set('codes', codes.join(','));
+
+      const res = await fetch(`/api/merchant/submissions?${params.toString()}`);
+      const data = await res.json();
+      if (data.success && data.submissions) {
+        setMySubmissions(data.submissions);
+      }
+    } catch (err) {
+      console.warn('[Fetch Merchant Submissions Warning]', err);
+    } finally {
+      setIsLoadingSubmissions(false);
+    }
+  };
+
+  useEffect(() => {
+    fetchMySubmissions();
+  }, [merchantPhone]);
+
+  return (
+    <div className="space-y-3 pb-12 animate-fade-in max-w-md mx-auto">
+      {/* Top Banner: Local Merchant Intake Guarantee */}
+      <div className="relative overflow-hidden rounded-2xl bg-gradient-to-br from-stone-900 via-amber-950 to-stone-950 text-white p-4 shadow-lg border border-amber-900/40">
+        <div className="relative z-10 space-y-2">
+          <div className="flex items-center justify-between">
+            <span className="inline-flex items-center space-x-1.5 px-2.5 py-0.5 rounded-full bg-amber-500/20 text-amber-300 text-[10px] font-bold border border-amber-500/30">
+              <ShoppingBag className="w-3 h-3 text-amber-400" />
+              <span>የነጋዴ እና የአቅራቢ ማዕከል (Merchant Portal)</span>
+            </span>
+            <span className="text-[9px] font-bold text-emerald-400 bg-emerald-950/80 px-2 py-0.5 rounded-md border border-emerald-700/50">
+              1-2 ቀን ማድረሻ
+            </span>
+          </div>
+
+          <h2 className="text-sm font-extrabold leading-snug">
+            በእጅዎ ያለውን እቃ በኮርቻ መደርደሪያ ላይ ይሽጡ!
+          </h2>
+
+          <p className="text-[11px] text-stone-300 leading-tight">
+            የእቃዎን መረጃ፣ ያለዎትን ብዛት እና የሚፈልጉትን ዋጋ ያስገቡ። ሰራተኛችን <b>@{workerUsername}</b> በቀጥታ አረጋግጦ መደርደሪያ ላይ ይጭንልዎታል።
+          </p>
+
+          <div className="flex items-center space-x-2 pt-1 text-[10px] text-amber-200/90 font-medium">
+            <ShieldCheck className="w-3.5 h-3.5 text-amber-400 shrink-0" />
+            <span>ቀጥታ ድርድር • 0% ተጨማሪ ኮሚሽን • ፈጣን የብር ክፍያ</span>
+          </div>
+        </div>
+      </div>
+
+      {/* Sub-Tabs: 1. አዲስ እቃ አስገባ (Submit) | 2. ያቀረብኳቸው እቃዎች (My Submissions) */}
+      <div className="flex rounded-xl bg-stone-200/80 p-1 text-xs font-bold gap-1 shadow-inner">
+        <button
+          onClick={() => setActiveSubTab('submit')}
+          className={`flex-1 py-1.5 rounded-lg flex items-center justify-center space-x-1.5 transition-all cursor-pointer ${
+            activeSubTab === 'submit'
+              ? 'bg-white text-stone-900 shadow-xs'
+              : 'text-stone-600 hover:text-stone-900'
+          }`}
+        >
+          <Package className="w-3.5 h-3.5 text-amber-600" />
+          <span>አዲስ እቃ አስገባ</span>
+        </button>
+
+        <button
+          onClick={() => {
+            setActiveSubTab('my_products');
+            fetchMySubmissions();
+          }}
+          className={`flex-1 py-1.5 rounded-lg flex items-center justify-center space-x-1.5 transition-all cursor-pointer ${
+            activeSubTab === 'my_products'
+              ? 'bg-white text-stone-900 shadow-xs'
+              : 'text-stone-600 hover:text-stone-900'
+          }`}
+        >
+          <Clock className="w-3.5 h-3.5 text-amber-600" />
+          <span>ያቀረብኳቸው እቃዎች</span>
+          {mySubmissions.length > 0 && (
+            <span className="ml-1 px-1.5 py-0.2 bg-amber-500 text-stone-950 text-[10px] font-black rounded-full">
+              {mySubmissions.length}
+            </span>
+          )}
+        </button>
+      </div>
+
