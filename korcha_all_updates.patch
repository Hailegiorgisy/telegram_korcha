+
+👉 <b>ለነጋዴው በቀጥታ በቦት መልስ ለመስጠት፡</b>
+<code>/reply ${ticketCode} ሰላም፣ እቃዎን መርምረናል...</code>
+`.trim();
+
+      const buttons = [];
+      if (telegramUsername) {
+        buttons.push([Markup.button.url('💬 በቴሌግራም አውራ', `https://t.me/${String(telegramUsername).replace(/^@/, '')}`)]);
+      }
+      const keyboard = buttons.length > 0 ? Markup.inlineKeyboard(buttons) : undefined;
+
+      if (photoFile) {
+        await bot.telegram.sendPhoto(WORKER_CHAT_ID, { source: photoFile.path }, {
+          caption: merchantAlert.length > 1000 ? merchantAlert.substring(0, 997) + '...' : merchantAlert,
+          parse_mode: 'HTML',
+          ...(keyboard || {})
+        }).catch(() => {});
+      } else {
+        await bot.telegram.sendMessage(WORKER_CHAT_ID, merchantAlert, {
+          parse_mode: 'HTML',
+          ...(keyboard || {})
+        }).catch(() => {});
+      }
+    }
+
+    res.json({ success: true, ticketCode, submission });
+  } catch (err) {
+    console.error('[Merchant Submission Error]', err);
+    res.status(500).json({ success: false, error: err.message });
+  }
+});
+
+// 2. GET /api/merchant/submissions: Strictly returns items belonging to the requesting merchant
+app.get('/api/merchant/submissions', async (req, res) => {
+  try {
+    const { phone, telegramId, codes } = req.query;
+    const cleanPhone = phone && isValidEthiopianPhone(phone) ? normalizePhone(phone) : null;
+    const parsedTgId = telegramId ? parseInt(String(telegramId), 10) : null;
+    const codeList = codes ? String(codes).split(',').map(c => c.trim()).filter(Boolean) : [];
+
+    if (!cleanPhone && !parsedTgId && codeList.length === 0) {
+      return res.json({ success: true, submissions: [] });
+    }
+
+    const submissions = await getMerchantSubmissions({
+      phone: cleanPhone,
+      telegramId: parsedTgId,
+      codes: codeList,
+    });
+
+    res.json({ success: true, submissions });
+  } catch (err) {
+    console.error('[Get Merchant Submissions Error]', err);
+    res.status(500).json({ success: false, error: err.message });
+  }
+});
+
+// 3. GET /api/worker/merchant-submissions: Worker list of all merchant inventory
+app.get('/api/worker/merchant-submissions', async (req, res) => {
+  try {
+    const submissions = await getAllMerchantSubmissionsForWorker();
+    res.json({ success: true, submissions });
+  } catch (err) {
+    res.status(500).json({ success: false, error: err.message });
+  }
+});
+
+// 4. POST /api/worker/merchant-submissions/:code/approve: Worker approves & publishes to public shelf
+app.post('/api/worker/merchant-submissions/:code/approve', async (req, res) => {
+  try {
+    const ticketCode = req.params.code;
+    const { publicPriceEtb, workerNotes, workerUsername } = req.body;
+
+    const result = await approveMerchantSubmissionToShelf({
+      ticketCode,
+      publicPriceEtb: publicPriceEtb ? parseFloat(publicPriceEtb) : undefined,
+      workerUsername: workerUsername || WORKER_USERNAME,
+      workerNotes: workerNotes || '',
+    });
+
+    // Notify merchant on Bot if customer telegram ID exists
+    if (bot && result.submission.merchant_telegram_id) {
+      const directMsg = `
+🎉 <b>ያቀረቡት እቃ ጸድቆ መደርደሪያችን ላይ ተቀምጧል!</b>
+━━━━━━━━━━━━━━━━━━━━
+🏷️ <b>የትኬት ኮድ:</b> <code>${ticketCode}</code>
+📦 <b>እቃ:</b> <b>${escapeHtml(result.product.name)}</b>
+💰 <b>የተስማማንበት ዋጋ:</b> <b>${Number(result.product.price_etb).toLocaleString()} ETB</b>
+━━━━━━━━━━━━━━━━━━━━
+ደንበኛ እቃዎን ሲያዝ ወዲያውኑ አሳውቀንዎ ክፍያ ፈጽመን እንረከባለን። ከኮርቻ ጋር ስለሰሩ እናመሰግናለን!
+`.trim();
+      bot.telegram.sendMessage(result.submission.merchant_telegram_id, directMsg, { parse_mode: 'HTML' }).catch(() => {});
+    }
+
+    res.json({ success: true, ...result });
+  } catch (err) {
+    console.error('[Approve Merchant Submission Error]', err);
+    res.status(500).json({ success: false, error: err.message });
+  }
+});
