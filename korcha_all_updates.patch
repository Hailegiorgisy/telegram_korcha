+-- 004_add_merchant_submissions.sql: Dedicated Table for Local Merchant Inventory Intake & Direct Negotiation with @korcha_support
+
+CREATE TABLE IF NOT EXISTS merchant_submissions (
+    id SERIAL PRIMARY KEY,
+    ticket_code VARCHAR(32) UNIQUE NOT NULL, -- e.g. MC-102938
+    merchant_phone VARCHAR(50) NOT NULL,
+    merchant_name VARCHAR(150),
+    merchant_telegram_id BIGINT,
+    merchant_telegram_username VARCHAR(150),
+    product_name VARCHAR(255) NOT NULL,
+    category_id VARCHAR(50) NOT NULL DEFAULT 'miscellaneous',
+    asking_price_etb NUMERIC(12, 2) NOT NULL,
+    quantity_at_hand INTEGER NOT NULL DEFAULT 1,
+    size_color_details TEXT,
+    photo_urls TEXT, -- JSON array string or primary photo filename/URL
+    status VARCHAR(30) NOT NULL DEFAULT 'pending_review' CHECK (status IN (
+        'pending_review',
+        'in_negotiation',
+        'approved_listed',
+        'rejected',
+        'out_of_stock'
+    )),
+    listed_shelf_product_id INTEGER,
+    agreed_shelf_price_etb NUMERIC(12, 2),
+    worker_notes TEXT,
+    assigned_worker VARCHAR(100) DEFAULT 'korcha_support',
+    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
+    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
+);
+
+CREATE INDEX IF NOT EXISTS idx_merchant_submissions_code ON merchant_submissions(ticket_code);
+CREATE INDEX IF NOT EXISTS idx_merchant_submissions_phone ON merchant_submissions(merchant_phone);
+CREATE INDEX IF NOT EXISTS idx_merchant_submissions_tg ON merchant_submissions(merchant_telegram_id);
+CREATE INDEX IF NOT EXISTS idx_merchant_submissions_status ON merchant_submissions(status);
