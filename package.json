{
  "name": "korcha-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "server": "node app.js",
    "build": "vite build || true",
    "migrate": "node -e 'import(\"./db.js\").then(m => m.runMigrations())'",
    "check": "node --input-type=module -e \"try { await import('./bot.js'); console.log('🎉 SUCCESS: bot.js starts cleanly!'); process.exit(0); } catch(e) { console.error('🚨 EXACT CRASH REASON:', e.stack||e.message); process.exit(1); }\""
  },
  "dependencies": {
    "express": "^4.19.2",
    "telegraf": "^4.16.3",
    "dotenv": "^16.4.5",
    "pg": "^8.11.5",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.3",
    "axios": "^1.6.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "framer-motion": "^11.1.7",
    "lucide-react": "^0.368.0",
    "vite": "^5.1.4",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19"
  }
}