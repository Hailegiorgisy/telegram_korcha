# ==============================================================================
# Telegram Korcha Environment Configuration Template
# ==============================================================================

# --- Telegram Bot & Mini App Configuration ---
TELEGRAM_BOT_TOKEN="123456789:ABCdefghIJKlmnopQRstuvwxYZ"
TELEGRAM_WORKER_CHAT_ID="-1001234567890"
TELEGRAM_WEB_APP_URL="https://telegram.korcha.com.et"
WORKER_TELEGRAM_USERNAME="korcha_support"
VITE_WORKER_TELEGRAM_USERNAME="korcha_support"

# --- Database Persistence (ACID-Compliant PostgreSQL) ---
# Use either full connection URI or individual parameters:
DATABASE_URL="postgresql://korcha_user:korcha_secure_password@localhost:5432/korcha_db"
PGHOST="localhost"
PGPORT="5432"
PGUSER="korcha_user"
PGPASSWORD="korcha_secure_password"
PGDATABASE="korcha_db"

# --- Dynamic Foreign Exchange & Sourcing Rates (ETB) ---
HKD_EXCHANGE_RATE="30.0"
USD_TO_HKD="7.8"
KG_CARGO_RATE_ETB="1000.0"
SUPPLIER_PERCENT="0.27"
DELIVERY_PERCENT="0.54"

# Client-Side Mirrors for Vite Build
VITE_HKD_EXCHANGE_RATE="30.0"
VITE_USD_TO_HKD="7.8"
VITE_KG_CARGO_RATE_ETB="1000.0"
VITE_SUPPLIER_PERCENT="0.27"
VITE_DELIVERY_PERCENT="0.54"

# --- Payment Split Ratios & Local Gateway Accounts ---
ADVANCE_PAYMENT_PERCENT="40"
COD_PAYMENT_PERCENT="60"
VITE_ADVANCE_PAYMENT_PERCENT="40"
VITE_COD_PAYMENT_PERCENT="60"

TELEBIRR_PHONE="+251-996237800"
CBE_ACCOUNT="10001116390"
VITE_TELEBIRR_PHONE="+251-996237800"
VITE_CBE_ACCOUNT="10001116390"

# --- Server Ports & Lifecycle ---
PORT="3000"
NODE_ENV="production"


# --- Security ---
# Only for local development: allow username-only worker RBAC without initData HMAC
# ALLOW_WORKER_BYPASS="1"
# NODE_ENV="development"
