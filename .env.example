# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Telegram Bot & Mini App (TMA) Configuration
TELEGRAM_BOT_TOKEN="123456789:ABCDefghIJKlmnoPQRstuvwxYZ"
TELEGRAM_WORKER_CHAT_ID="-1001234567890"
TELEGRAM_WEB_APP_URL="https://your-domain.com"
HKD_EXCHANGE_RATE="30.0"
KG_CARGO_RATE_ETB="1000.0"
TELEBIRR_PHONE="+251-996237800"
CBE_ACCOUNT="10001116390"

# Dynamic Payment Ratios (Advance deposit % and Cash-On-Delivery %)
# Defaults: 40% advance payment, 60% cash-on-delivery
ADVANCE_PAYMENT_PERCENT="40"
COD_PAYMENT_PERCENT="60"
VITE_ADVANCE_PAYMENT_PERCENT="40"
VITE_COD_PAYMENT_PERCENT="60"
VITE_TELEBIRR_PHONE="+251-996237800"
VITE_CBE_ACCOUNT="10001116390"

