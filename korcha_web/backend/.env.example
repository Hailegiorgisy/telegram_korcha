# ==============================================================================
# Korcha Web Platform - Environment Configuration Template
# ==============================================================================

# --- Server Port & Environment ---
PORT="5000"
NODE_ENV="production"

# --- Concierge / Worker Support Telegram Account ---
WORKER_TELEGRAM_USERNAME="korcha_support"
TELEGRAM_BOT_TOKEN="123456789:ABCdefghIJKlmnopQRstuvwxYZ"
TELEGRAM_WORKER_CHAT_ID="-1001234567890"

# --- Database Persistence (ACID-Compliant PostgreSQL) ---
# Automatically falls back to in-memory store if offline
DATABASE_URL="postgresql://korcha_user:korcha_password@localhost:5432/korcha_db"
PGHOST="localhost"
PGPORT="5432"
PGUSER="korcha_user"
PGPASSWORD="korcha_password"
PGDATABASE="korcha_db"

# --- Dynamic Foreign Exchange & Cargo Rates (ETB) ---
HKD_EXCHANGE_RATE="30.0"
USD_TO_HKD="7.8"
KG_CARGO_RATE_ETB="1000.0"
SUPPLIER_PERCENT="0.27"
DELIVERY_PERCENT="0.54"

# --- Payment Split Ratios & Gateways ---
ADVANCE_PAYMENT_PERCENT="40"
COD_PAYMENT_PERCENT="60"
TELEBIRR_PHONE="+251-996237800"
CBE_ACCOUNT="10001116390"
